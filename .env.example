# ===== Application =====
# Server host (0.0.0.0 for all interfaces)
HOST=0.0.0.0
# Server port (cloud platforms auto-assign via $PORT)
PORT=8000

# ===== AI API Keys =====
TTAPI_API_KEY=your_ttapi_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
TINYFISH_API_KEY=your_tinyfish_api_key_here

# ===== LLM Router (Multi-Provider) =====
# TTAPI (OpenAI Compatible)
TTAPI_API_KEY=
TTAPI_BASE_URL=https://ttapi.io/v1
TTAPI_MODEL=gpt-4o

# Agnes AI (OpenAI Compatible, 全模态永久免费, Primary 3)
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash

# Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Ollama (Local LLM)
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b

# ===== 免费 LLM Provider (全部 OpenAI 兼容) =====
# 支持多Key轮换:设置 XXX_API_KEYS=key1,key2 (逗号分隔)
# 注册入口/免费限额/核实日期见 docs/free-llm-providers.md;不填 Key 则不加载,不影响其他链路。

# 智谱 GLM (GLM-4.7-Flash 免费,200K 上下文,30并发) 注册: https://open.bigmodel.cn
ZHIPU_API_KEY=
ZHIPU_API_KEYS=
ZHIPU_MODEL=glm-4.7-flash
ZHIPU_MODEL_FALLBACK=glm-4.5-flash

# 硅基流动 SiliconFlow (Qwen2-7B 等 7 个模型免费,1000 RPM) 注册: https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=
SILICONFLOW_API_KEYS=
SILICONFLOW_MODEL=Qwen/Qwen2-7B-Instruct

# 讯飞星火 Lite (免费,OpenAI 兼容) 注册: https://console.xfyun.cn (取 APIPassword 当 Key)
SPARK_API_KEY=
SPARK_API_KEYS=
SPARK_MODEL=lite

# 阿里云百炼 DashScope (qwen-turbo 新人免费额度 90 天) 注册: https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=
DASHSCOPE_API_KEYS=
DASHSCOPE_MODEL=qwen-turbo

# 百度千帆 ERNIE-Speed (永久免费,免费档 QPS 1) 注册: https://console.bce.baidu.com/qianfan
QIANFAN_API_KEY=
QIANFAN_API_KEYS=
QIANFAN_MODEL=ernie-speed-128k

# Groq (免费档约 30 RPM,极速) 注册: https://console.groq.com
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile

# Cerebras Inference (免费档 5 RPM / 100万 tokens/日) 注册: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_API_KEYS=
CEREBRAS_MODEL=gpt-oss-120b

# OpenRouter (免费模型 20 RPM;免费模型 ID 会轮换,可用 openrouter/free 自动选) 注册: https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# DeepSeek (低价兜底,Fallback 3)
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEYS=
DEEPSEEK_MODEL=deepseek-chat

# Cloudflare Workers AI (边缘节点,Fallback 4)
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# ===== Search Engines =====
SERPAPI_KEY=
BING_SEARCH_KEY=

# ===== Tushare API Token =====
TUSHARE_TOKEN=your_tushare_token_here

# ===== Broker API =====
# 预留（未实现）
# BROKER_API_KEY=
# BROKER_API_SECRET=
# BROKER_ID=

# ===== DingTalk Notification =====
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# ===== WeChat Work Notification =====
WECHAT_WEBHOOK=

# ===== App Settings (override config/settings.yaml via APP_ prefix) =====
# Example: APP_SETTINGS__BROKER__TYPE=simulated
# Example: APP_SETTINGS__APP__DEBUG=false
APP_SETTINGS__BROKER__TYPE=simulated
APP_SETTINGS__APP__DEBUG=false

# ===== Admin Token (protects /api/config/* PUT and /api/trade/* write endpoints) =====
# Leave empty for dev mode (no auth, just a warning). For production, set to a random long string.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ===== Redis (仅预留配置,P1/P2/P3 不实现,后续扩展) =====
# 开发环境留空使用内存缓存;生产环境如需启用 Redis 可设置此变量
REDIS_URL=

# ===== CORS (P2 前端部署 Vercel 后需添加域名) =====
# 示例:CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
