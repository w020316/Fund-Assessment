# 运行时用户数据
web/user_fund_positions.json
web/user_*.json
# atomic_write_json 产生的同目录备份（含用户数据，不入库）
web/user_*.json.bak

# data/ 运行时配置与自动备份：分组配置/推送节流/账本导入备份/QA 临时备份均含用户数据
data/portfolio/
data/backup/
data/_*.json

# SQLite 运行时状态(非源码; prediction.db 由 prediction.yml 备份到 daily-reports 分支)
# 注意: 上方 `*.db` 无法覆盖伴随文件(glob 要求文件名以 .db 结尾, 匹配不到 .db-wal),
# 下面 4 条不可删; 删掉会导致每次跑服务/测试后 `?? data/` 复发。
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal

# 测试产物
.coverage
coverage.json
htmlcov/
.pytest_cache/

# 真机走查临时脚本与截图（可能含用户持仓画面）
.tmp/
# 多端页面走查截图（体积大且可能含用户持仓画面）
.screenshots/

# 临时验证脚本
verify_full.py

# 本地 AI 协作工作目录（会话态，不入库）
